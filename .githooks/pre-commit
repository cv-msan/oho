#!/bin/sh
set -e

echo "🔍 运行 cargo fmt 检查..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ 代码格式不符合规范，请先运行：cargo fmt --all"
    exit 1
fi

echo "🔍 运行 cargo clippy..."
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ clippy 检查未通过，请修复以上警告后重新提交"
    exit 1
fi

echo "✅ pre-commit 检查通过"